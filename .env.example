# ---------------------------------------------------------------------------
# JanVaani UP — environment configuration
# Copy to `.env` and fill in what you have. EVERY value is optional:
# the app ships with deterministic offline twins for every AI call.
# ---------------------------------------------------------------------------

# --- Groq : chat LLM + Whisper ASR -----------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Bhashini (ULCA) : optional native-dialect ASR/TTS ----------------------
# Get a key at https://bhashini.ai  (leave blank to use edge-tts)
BHASHINI_API_KEY=
BHASHINI_BASE_URL=https://api.bhashini.ai/v1

# --- Text-to-Speech ---------------------------------------------------------
# auto -> edge-tts (free, high quality Hindi) -> bhashini -> browser fallback
TTS_PROVIDER=auto
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_M=hi-IN-MadhurNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# --- Vector store -----------------------------------------------------------
# local  -> built-in hybrid BM25 + character n-gram retriever (no downloads)
# chroma -> ChromaDB persistent client (optional, pip install chromadb)
VECTOR_BACKEND=local

# --- Storage ----------------------------------------------------------------
DB_PATH=./.runtime/janvaani.db
AUDIO_OUT_DIR=./.runtime/audio

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
LOG_LEVEL=INFO

# --- WhatsApp Cloud API (optional stub) -------------------------------------
WHATSAPP_VERIFY_TOKEN=janvaani_up_verify_token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
