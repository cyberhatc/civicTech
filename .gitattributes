# Normalise line endings so the repo is consistent across Windows and Linux.
* text=auto

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.ps1   text eol=crlf

*.png   binary
*.mp3   binary
*.webm  binary
